# ==============================================================================
# ReFind - Campus Pre-Owned Marketplace Environment Configuration (.env.example)
# Copy this file to '.env' and adjust the values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE DJANGO SETTINGS
# ------------------------------------------------------------------------------
SECRET_KEY=replace-with-a-secure-random-secret-key-for-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ------------------------------------------------------------------------------
# 2. UNIVERSITY EMAIL RESTRICTION
# ------------------------------------------------------------------------------
# Set to '*' to allow registration from ANY email provider (Gmail, Outlook, Yahoo, etc.).
# To restrict strictly to university domains, provide a comma-separated list:
# CAMPUS_EMAIL_DOMAINS=campus.edu,student.edu,university.ac.in
CAMPUS_EMAIL_DOMAINS=*

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# USE_POSTGRES=False uses zero-config SQLite (db.sqlite3).
# Set USE_POSTGRES=True when PostgreSQL is running and credentials are set below.
USE_POSTGRES=False
DB_NAME=refind_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# ------------------------------------------------------------------------------
# 4. EMAIL CONFIGURATION (Verification Links & Password Resets)
# ------------------------------------------------------------------------------
# Development Mode: Prints emails to terminal/console (no credentials needed).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Production SMTP Settings (e.g. Gmail App Password):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your_email@gmail.com
# EMAIL_HOST_PASSWORD=your_gmail_app_password
DEFAULT_FROM_EMAIL=ReFind Campus Marketplace <no-reply@refind.campus.edu>

# ------------------------------------------------------------------------------
# 5. CLOUDINARY MEDIA STORAGE (Optional)
# ------------------------------------------------------------------------------
# Leave blank to use local 'media/' folder. Fill in to use Cloudinary CDN in production:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
